configuration { show-icons: true; }

@import "/home/g0nxz/.cache/wal/colors-rofi.rasi"

* {
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 70%;
    border-radius: 16px;
    background-color: @bg;
    padding: 20px;
}

mainbox { children: [ inputbar, listview ]; spacing: 16px; }

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px 14px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry  { placeholder: "Buscar wallpaper..."; placeholder-color: @fg-dim; }

listview {
    lines: 1;
    columns: 5;
    flow: horizontal;
    spacing: 16px;
    scrollbar: false;
    cycle: true;
}

element {
    orientation: vertical;
    padding: 6px;
    border-radius: 12px;
}
element selected {
    background-color: @accent-dim;
    border: 2px;
    border-color: @accent;
}
element-icon { size: 160px; border-radius: 8px; }
element-text { horizontal-align: 0.5; margin: 6px 0 0 0; }
