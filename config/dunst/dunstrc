[global]
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark"
    progress_bar_corner_radius = 4
    progress_bar_frame_width = 0
    progress_bar_height = 8
    monitor = 0
    follow = mouse
    width = 340
    height = (0, 150)
    offset = (15, 50)
    origin = top-right
    notification_limit = 5
    progress_bar = true
    indicate_hidden = yes
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    gap_size = 6
    corner_radius = 12
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#05050bd9"
    foreground = "#c0c0c2"
    frame_color = "#545467"
    highlight = "#CC044E"
    timeout = 5

[urgency_normal]
    background = "#05050bd9"
    foreground = "#c0c0c2"
    frame_color = "#CC044E"
    highlight = "#CC044E"
    timeout = 8

[urgency_critical]
    background = "#05050bd9"
    foreground = "#c0c0c2"
    frame_color = "#661E4E"
    highlight = "#CC044E"
    timeout = 0

[volumen]
    format = "%b"
    markup = full
    icon_position = left
    appname = volumen
    history_ignore = yes
