[global]
    monitor = 0
    follow = mouse
    width = 340
    height = (0, 150)
    offset = (15, 50)
    origin = top-right
    notification_limit = 5
    progress_bar = true
    indicate_hidden = yes
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    gap_size = 6
    corner_radius = 12
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#140d20"
    foreground = "#c4c2c7"
    frame_color = "#655d71"
    timeout = 5

[urgency_normal]
    background = "#140d20"
    foreground = "#c4c2c7"
    frame_color = "#B22CC2"
    timeout = 8

[urgency_critical]
    background = "#140d20"
    foreground = "#c4c2c7"
    frame_color = "#543FB8"
    timeout = 0
